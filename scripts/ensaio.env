# Parâmetros do docker-compose.yml para os ensaios. Copie e ajuste, e
# aponte ENSAIO_ENV para a cópia ao rodar scripts/ensaio.sh, ou use
# "docker compose --env-file <arquivo>" diretamente.

# Imagem construída a partir do Dockerfile da raiz.
IMAGEM=pubsub-middleware:ensaio

# Credenciais montadas nos dois brokers (caminho relativo à raiz).
CREDENCIAIS=config/credentials.ensaio.json
TOKEN_PAR=ensaio-par

# Portas publicadas no host, para clientes de carga fora do Docker.
A_PORTA_TCP=7000
A_PORTA_UDP=7001
B_PORTA_TCP=7100
B_PORTA_UDP=7101

# Recursos de cada broker.
A_CPUS=1
A_MEMORIA=256m
B_CPUS=1
B_MEMORIA=256m

# Registros: text ou json; debug, info, warn ou error.
LOG_FORMATO=text
LOG_NIVEL=info

# Sondas: tópicos observados (nome=estado para tópico de estado) e
# silêncio que caracteriza falha do broker.
TOPICOS=sala-1/lances,sala-1/reacoes,sala-1/placar=estado
SILENCIO=5s
